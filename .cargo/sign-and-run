#!/bin/sh
# Cargo runner: sign the binary cargo is about to run, then run it.
#
# A linker-signed (ad-hoc) binary is a new identity on every rebuild, so
# the Keychain asks afresh each time the app reads a secret. Signed with
# a real identity, the app is the same app to the Keychain across
# rebuilds, and one "Always Allow" per item is the last dialog you see.
# `tauri build` signs with the same APPLE_SIGNING_IDENTITY; this does the
# equivalent for what `tauri dev` and `cargo run/test` launch.
set -e
if [ -n "$APPLE_SIGNING_IDENTITY" ]; then
    codesign --sign "$APPLE_SIGNING_IDENTITY" --force --timestamp=none "$1"
fi
exec "$@"
