{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epik",
  "version": "0.1.0",
  "identifier": "dev.epik.app",
  "build": {
    "frontendDist": "../epik-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../epik-ui",
      "script": "trunk serve"
    },
    "beforeBuildCommand": {
      "cwd": "../epik-ui",
      "script": "trunk build --release"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Epik",
        "width": 900,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
