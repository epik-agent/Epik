{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epik",
  "identifier": "dev.epik-agent.epik",
  "build": {
    "frontendDist": "../epik-ui/dist",
    "beforeDevCommand": { "script": "trunk build", "cwd": "../epik-ui", "wait": true },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../epik-ui" }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOEVFRUVDMTE1NTg0NjAKUldSZ2hGVVI3TzZPbXZsQ05YRXhwL3NUUVFEZERxTHB4QUpwUGdOb214ejJoSmNJUnFBT0l6N1YK",
      "endpoints": ["https://github.com/epik-agent/Epik/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "The Epik app, which runs Epik's builds.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2"
        ]
      }
    }
  }
}
