{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epik",
  "identifier": "dev.epik-agent.app",
  "build": {
    "frontendDist": "../epik-ui/dist",
    "beforeDevCommand": { "script": "trunk build", "cwd": "../epik-ui", "wait": true },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../epik-ui" }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "The Epik app, which runs Epik's builds.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2"
        ]
      }
    }
  }
}
